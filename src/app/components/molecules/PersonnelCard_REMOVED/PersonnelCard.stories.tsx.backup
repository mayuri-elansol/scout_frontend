import type { Meta, StoryObj } from '@storybook/react';
import PersonnelCard from './PersonnelCard';

const meta: Meta<typeof PersonnelCard> = {
  title: 'Components/Molecules/PersonnelCard',
  component: PersonnelCard,
  parameters: {
    layout: 'padded',
    docs: {
      description: {
        component: 'SCOUT Personnel Card component for tracking employee status and location. Shows live feed preview, status badges, and action buttons for tracking and profile access.',
      },
    },
  },
  tags: ['autodocs'],
  argTypes: {
    status: {
      control: 'select',
      options: ['active', 'on_break', 'missing', 'offline'],
      description: 'Employee status',
    },
    liveFeedStatus: {
      control: 'select',
      options: ['live', 'offline', 'loading'],
      description: 'Live feed status',
    },
    employeeName: {
      control: 'text',
      description: 'Employee name',
    },
    zone: {
      control: 'text',
      description: 'Current zone location',
    },
    shift: {
      control: 'text',
      description: 'Work shift',
    },
    role: {
      control: 'text',
      description: 'Job role/title',
    },
    employeeId: {
      control: 'text',
      description: 'Employee ID',
    },
    lastSeen: {
      control: 'text',
      description: 'Last seen timestamp (ISO string)',
    },
    onTrack: {
      action: 'track-clicked',
      description: 'Track button handler',
    },
    onProfile: {
      action: 'profile-clicked',
      description: 'Profile button handler',
    },
    onViewFeed: {
      action: 'feed-clicked',
      description: 'Live feed click handler',
    },
    onClick: {
      action: 'card-clicked',
      description: 'Card click handler',
    },
  },
};

export default meta;
type Story = StoryObj<typeof meta>;

